import QtQuick
import Caelestia.Config
import qs.components
import qs.services
import dcqwqc.remotedesktop.services as RemoteDesktop

Item {
    id: root

    implicitWidth: icon.implicitHeight + Tokens.padding.small
    implicitHeight: icon.implicitHeight

    MaterialIcon {
        id: icon

        anchors.centerIn: parent

        text: "cast_connected"
        color: Colours.palette.m3secondary
        fontStyle: Tokens.font.icon.small
    }

    // Reachability indicator for the configured remote-desktop peer.
    // Green  = Tailscale online + SSH reachable.
    // Amber  = Tailscale online, but SSH is not reachable.
    // Red    = peer is offline on Tailscale.
    // Gray   = no peer / still waiting for the SSH probe.
    // Streaming state is deliberately separate from host health.
    Rectangle {
        readonly property var peer: RemoteDesktop.RemoteStatus.devices.find(device => device.id === RemoteDesktop.RemoteStatus.peerId)
        readonly property string health: !peer
            ? "unknown"
            : !peer.online
                ? "offline"
                : !peer.sshKnown
                    ? "unknown"
                    : peer.sshAvailable
                        ? "reachable"
                        : "degraded"

        visible: true
        width: 6
        height: 6
        radius: 3
        anchors.right: icon.right
        anchors.bottom: icon.bottom
        anchors.rightMargin: -1
        anchors.bottomMargin: -1
        color: health === "reachable"
            ? "#43a047"
            : health === "degraded"
                ? "#d99a00"
                : health === "offline"
                    ? Colours.palette.m3error
                    : Colours.palette.m3outline
        border.width: 1
        border.color: Colours.palette.m3surface
    }
}
