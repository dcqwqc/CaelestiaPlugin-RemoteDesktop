#!/usr/bin/env bash
# Diagnose and repair the local services that the Remote Desktop popout relies on.
# The explicit repair-tailscale mode authorizes exactly one local service
# restart via polkit. The ordinary diagnosis never mutates network state.
set -u

mode=${1:-diagnose}

if [[ $mode == repair-user ]]; then
    # `try-restart` is deliberate: optional tunnels stay off when the user has
    # them disabled, while active services get a clean restart.
    for unit in \
        app-dev.lizardbyte.app.Sunshine.service \
        philipedia-mcp-tunnel.service \
        sumi-openai-tunnel.service
    do
        systemctl --user try-restart "$unit" >/dev/null 2>&1 || true
    done
    exit 0
fi

# Automatic recovery only starts enabled but stopped user services.
# Never restart active sessions, SSH, Tailscale, or modify a VPN route.
if [[ $mode == repair-safe ]]; then
    started=""
    failed=""
    for unit in philipedia-mcp-tunnel.service sumi-openai-tunnel.service; do
        systemctl --user is-enabled --quiet "$unit" 2>/dev/null || continue
        systemctl --user is-active --quiet "$unit" 2>/dev/null && continue
        if systemctl --user start "$unit" >/dev/null 2>&1 &&
                systemctl --user is-active --quiet "$unit"; then
            started="$started $unit"
        else
            failed="$failed $unit"
        fi
    done
    jq -nc --arg started "$started" --arg failed "$failed"       '{ok:($failed==""),started:$started,failed:$failed,message:(if $failed!="" then "Some enabled user services could not be started." elif $started!="" then "Recovered stopped user services." else "Retried connectivity checks; no restart necessary." end)}'
    [[ -z "$failed" ]]
    exit
fi

if [[ $mode == repair-tailscale ]]; then
    # A local user action only. No automatic restart from a polling refresh;
    # sudo privileges are not cached or inferred from the SSH session.
    if ! command -v pkexec >/dev/null 2>&1; then
        jq -cn '{ok:false,message:"Polkit is unavailable. Reconnect Tailscale from a local terminal."}'
        exit 1
    fi
    error=$(pkexec /usr/bin/systemctl restart tailscaled.service 2>&1)
    result=$?
    if (( result != 0 )); then
        jq -cn --arg message "Tailscale restart was not authorized or failed: ${error:0:160}" \
            '{ok:false,message:$message}'
        exit 1
    fi
    backend=$(tailscale status --json 2>/dev/null | jq -r '.BackendState // "Stopped"' 2>/dev/null || true)
    if [[ $backend != Running ]]; then
        jq -cn --arg backend "${backend:-Stopped}" \
            '{ok:false,message:("Tailscale service restarted but the backend is " + $backend + ". Open Tailscale to sign in or repair the connection.")}'
        exit 1
    fi
    if ! tailscale ping --c 1 --timeout 5s philipedia >/dev/null 2>&1; then
        jq -cn '{ok:false,message:"Tailscale is running, but Philipedia cannot be reached yet. Check the Tailscale peer connection."}'
        exit 1
    fi
    if ! curl -fsSI --connect-timeout 3 --max-time 6 https://home.qwqc.de/ >/dev/null 2>&1; then
        jq -cn '{ok:false,message:"Philipedia responds over Tailscale, but Home Dashboard HTTPS is still unavailable."}'
        exit 1
    fi
    health=$(curl -fsS --connect-timeout 3 --max-time 6 https://home.qwqc.de/api/v1/health 2>/dev/null || true)
    if ! jq -e '.service == "home-api" and .status == "ok"' <<< "$health" >/dev/null 2>&1; then
        jq -cn '{ok:false,message:"Home Dashboard responds, but the Home API health check has not recovered."}'
        exit 1
    fi
    jq -cn '{ok:true,message:"Tailscale, Home Dashboard and Home API are reachable."}'
    exit 0
fi

if [[ $mode != diagnose ]]; then
    echo "usage: connectivity-repair [diagnose|repair-safe|repair-user|repair-tailscale]" >&2
    exit 2
fi

connection=$(nmcli -t -f GENERAL.CONNECTION device show wlan0 2>/dev/null | sed -n 's/^GENERAL.CONNECTION://p' | head -1)
[[ -n ${connection:-} ]] || connection="Unknown network"

backend=$(tailscale status --json 2>/dev/null | jq -r '.BackendState // "Stopped"' 2>/dev/null || printf 'Stopped')
if [[ $backend == Running ]]; then
    state=online
    message="Tailscale is connected on ${connection}."
elif ! curl -fsSI --connect-timeout 3 --max-time 5 https://example.com >/dev/null 2>&1; then
    state=offline
    message="No working internet connection on ${connection}."
elif ! curl -sSI --connect-timeout 3 --max-time 5 'https://controlplane.tailscale.com/key?v=142' >/dev/null 2>&1; then
    # Ordinary HTTPS works but the Tailscale control plane does not. This is the
    # exact failure seen on filtered Wi-Fi: restarting the daemon cannot remove
    # an upstream block, so tell the user the useful next action instead of
    # spinning forever.
    state=blocked
    message="${connection} is blocking Tailscale. Use mobile data or another Wi-Fi."
else
    state=needs-login
    message="Tailscale can reach its control plane but is not connected. Open Tailscale and sign in."
fi

jq -cn --arg state "$state" --arg message "$message" --arg network "$connection" --arg backend "$backend" \
    '{state:$state,message:$message,network:$network,backend:$backend}'
