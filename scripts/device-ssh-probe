#!/usr/bin/env python3
"""Report per-device TCP/22 reachability without hiding underlying socket errors."""
import concurrent.futures
import json
import socket
import sys


def probe(host):
    try:
        with socket.create_connection((host, 22), timeout=1.2):
            pass
        return host, {"reachable": True, "reason": ""}
    except OSError as exc:
        detail = str(exc).strip() or exc.__class__.__name__
        return host, {"reachable": False, "reason": f"SSH TCP/22 at {host}: {detail}"}


def main(hosts):
    if not hosts:
        print("{}")
        return
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(12, len(hosts))) as executor:
        results = dict(executor.map(probe, dict.fromkeys(hosts)))
    print(json.dumps(results, ensure_ascii=False))


if __name__ == "__main__":
    main(sys.argv[1:])
